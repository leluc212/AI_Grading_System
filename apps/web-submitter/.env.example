# URL gốc của API backend (API Gateway HTTP API).
# Ví dụ: VITE_API_BASE_URL=https://abcxyz.execute-api.ap-southeast-1.amazonaws.com
# Lưu ý: Không để dấu gạch chéo '/' ở cuối URL.
# Để trống (hoặc không tạo file .env.local) = chạy chế độ mock MSW offline trong trình duyệt.
# VITE_API_BASE_URL=

# Google OAuth 2.0 Client ID (từ Google Cloud Console)
# Ví dụ: VITE_GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=
