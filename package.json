{
  "name": "quick-grading",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web cham bai sinh vien bang AI - monorepo (Giai doan 1: UI local voi mock server)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed:grading": "npm run seed:grading --workspace @quick-grading/api-service",
    "smoke:openai": "npm run smoke:openai --workspace @quick-grading/api-service",
    "trigger:grading": "npm run trigger:grading --workspace @quick-grading/api-service"
  },
  "devDependencies": {
    "@eslint/js": "9.9.0",
    "eslint": "9.9.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.9.0",
    "prettier": "3.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
