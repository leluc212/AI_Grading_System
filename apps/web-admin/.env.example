# URL gốc của API backend (API Gateway HTTP API).
# Ví dụ: VITE_API_BASE_URL=https://jb9dbtvu30.execute-api.ap-southeast-1.amazonaws.com
# Lưu ý: Không để dấu gạch chéo '/' ở cuối URL.
# Để trống (hoặc không tạo file .env.local) = chạy chế độ mock MSW offline trong trình duyệt.
# VITE_API_BASE_URL=

# AWS Cognito User Pool Client ID cho Admin (không secret)
# VITE_COGNITO_CLIENT_ID=2ck2l1fmjmd61a94d1g8i0pi51

# AWS Region của Cognito User Pool (mặc định: ap-southeast-1)
# VITE_COGNITO_REGION=ap-southeast-1
